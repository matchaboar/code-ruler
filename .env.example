# GitHub Extractor
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon Bedrock (Code Ruler LLM calls)
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SESSION_TOKEN=

# Datadog LLM Observability (optional)
DD_API_KEY=
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=code-ruler
DD_SITE=datadoghq.com
# Enable tracing so ddtrace auto-instruments anthropic calls with input/output content
DD_TRACE_ENABLED=1

# Minimax Video Generation (optional)
MINIMAX_API_KEY=

# DBOS Durable Workflows (optional – leave unset to use legacy thread-based runner)
DBOS_SYSTEM_DATABASE_URL=postgresql://dbos:dbos@localhost:5432/code_ruler_dbos
